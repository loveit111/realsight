# RealSight 第 14 章：只容器化 Python API。摄像头/C++ gRPC 运行时应继续在宿主机运行。
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.30 /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY contracts ./contracts
COPY config ./config
COPY python ./python
COPY test-data ./test-data

# 使用锁定文件安装，镜像构建不会重新解析依赖版本。
RUN uv sync --locked --no-dev

ENV PATH="/app/.venv/bin:${PATH}"
ENV REALSIGHT_DATA_DIR="/app/runtime-data"
EXPOSE 8000

# 默认绑定全部容器接口；Compose 再将宿主机端口限制为 127.0.0.1。
CMD ["realsight-api", "--host", "0.0.0.0", "--port", "8000"]
