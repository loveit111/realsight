{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-gcc-debug",
      "displayName": "Windows MSYS2 GCC Debug",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/windows-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-gcc-debug",
      "configurePreset": "windows-gcc-debug",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "windows-gcc-debug",
      "configurePreset": "windows-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

